{
  "manifest_version": 3,
  "name": "Oraforge eTIMS Companion",
  "version": "1.1.5",
  "description": "Fill official KRA eTIMS invoice forms from Oraforge POS for cashier review.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://ecitizen.kra.go.ke/*", "https://kra.ecitizen.go.ke/*", "https://etims.kra.go.ke/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "Oraforge eTIMS · Scroll experiment", "default_popup": "keepalive.html"},
  "content_scripts": [
    {"matches": ["http://localhost/*", "http://127.0.0.1/*"], "js": ["pos-bridge.js"], "run_at": "document_start"},
    {"matches": ["https://ecitizen.kra.go.ke/*", "https://kra.ecitizen.go.ke/*", "https://etims.kra.go.ke/*"], "js": ["portal-sites.js", "portal-adapter.js", "portal.js", "scroll-keepalive.js"], "run_at": "document_idle"}
  ]
}
