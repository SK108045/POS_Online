{
  "name": "oraforge-pos-app",
  "version": "1.0.0",
  "description": "Oraforge POS Android wrapper via Capacitor",
  "private": true,
  "scripts": {
    "build": "echo 'Frontend ready in www/'",
    "cap": "cap",
    "build:bridge": "node prepare-provider-config.js && esbuild src/sqlite-bridge.js --bundle --format=iife --platform=browser --outfile=www/sqlite-bridge.js",
    "dev": "node dev-server.js",
    "start": "node dev-server.js"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/cli": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor-community/sqlite": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
